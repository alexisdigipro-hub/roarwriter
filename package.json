{
  "name": "roarwriter",
  "productName": "RoarWriter",
  "version": "0.1.0",
  "description": "RoarWriter: screenwriting in the industry format, English and Greek. The Mad Lions Lab.",
  "author": "THEMADLIONS",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx serve app",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.themadlions.roarwriter",
    "productName": "RoarWriter",
    "directories": { "output": "out", "buildResources": "electron/build" },
    "files": ["electron/main.js", "electron/preload.js", "electron/updater.js", "app/**/*", "package.json"],
    "afterPack": "./electron/adhoc-sign.js",
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "RoarWriter-${version}-beta-Mac-${arch}.${ext}"
    },
    "dmg": { "artifactName": "RoarWriter-${version}-beta-Mac-${arch}.${ext}", "title": "RoarWriter" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "RoarWriter-${version}-beta-Windows-Setup.${ext}"
    },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "artifactName": "RoarWriter-${version}-beta-Windows-Setup.${ext}" }
  }
}
